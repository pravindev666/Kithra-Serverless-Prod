FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build:jobs
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/apps/jobs-node/dist ./dist
COPY --from=build /app/node_modules ./node_modules
USER node
CMD ["node","dist/index.js"]
